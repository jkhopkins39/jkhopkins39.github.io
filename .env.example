# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Legacy alias (also accepted by the app):
# VITE_SUPABASE_ANON_KEY=your_publishable_key
VITE_ADMIN_EMAIL=jeremy@hoppytech.com

# Server (Vercel API routes — any one service-role key name works)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_secret_key
# Legacy aliases also supported by api/_lib/supabase-admin.js:
# SUPABASE_SECRET_KEY=
# VITE_SUPABASE_SECRET_KEY=  (avoid — exposes secret naming to client builds)

RESEND_API_KEY=
RESEND_FROM=Hoppy Tech Intake <hello@hoppytech.com>
RESEND_TO=jeremy@hoppytech.com
RESEND_DESIGN_TO=bella@hoppytech.com
# All contact/referral/chatbot intake emails are sent to both addresses above.
ADMIN_EMAIL=jeremy@hoppytech.com

# Google Ads lead-form webhook (must match the "Google key" in Ads)
# Webhook URL after deploy: https://www.hoppytech.com/api/webhooks/google-ads
GOOGLE_ADS_WEBHOOK_KEY=generate-a-long-random-secret

GEMINI_API_KEY=
GITHUB_TOKEN=
PORT=3001

# ── Contact-form screening (Gemini 3.5 Flash-Lite) ──────────────────────
# Reuses GEMINI_API_KEY above. Without it, submissions are accepted
# unscreened rather than lost.
# Set to "off" to bypass screening entirely (accepts everything).
CONTACT_SCREENING=on
# Max contact submissions per IP per hour before a 429. Default 5.
CONTACT_RATE_LIMIT_PER_HOUR=5

# ── Optional contact verification providers ─────────────────────────────
# Without these, email is checked by syntax + disposable-domain list + live MX
# lookup, and phone by E.164/NANP structural rules. Adding them upgrades both
# to "this mailbox/number actually exists" checks.
ZEROBOUNCE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
